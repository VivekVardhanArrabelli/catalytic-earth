{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalytic.earth/schemas/atlas50-review-queue-v1.schema.json",
  "title": "Catalytic Earth Atlas-50 review queue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "queue_id", "queue_type", "status", "baseline_commit", "phase_a_source", "packet_count", "reviewed_packet_count", "review_attempted", "independent_review_claimed", "submission_schema", "packets", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "catalytic-earth.atlas50-review-queue.v1"},
    "queue_id": {"type": "string", "minLength": 1},
    "queue_type": {"enum": ["crosswalk", "panel"]},
    "status": {"const": "ready_for_real_review_no_review_attempted"},
    "baseline_commit": {"const": "375548419e7435efa2bffc89be5e32aa70864875"},
    "phase_a_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "packet_count": {"enum": [40, 57]},
    "reviewed_packet_count": {"const": 0},
    "review_attempted": {"const": false},
    "independent_review_claimed": {"const": false},
    "submission_schema": {"const": "src/catalytic_earth/schemas/atlas50-review-submission-v1.schema.json"},
    "packets": {
      "type": "array",
      "minItems": 40,
      "maxItems": 57,
      "items": {
        "type": "object",
        "required": ["packet_id", "packet_type", "ordinal", "phase_a_row_sha256", "machine_draft", "review_requirements", "review_state"],
        "properties": {
          "packet_id": {"type": "string", "minLength": 1},
          "packet_type": {"enum": ["crosswalk", "panel"]},
          "ordinal": {"type": "integer", "minimum": 1},
          "phase_a_row_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "machine_draft": {"type": "object"},
          "review_requirements": {"type": "object"},
          "review_state": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "review_attempted", "submission_ids", "reviewer_count"],
            "properties": {
              "status": {"const": "unreviewed"},
              "review_attempted": {"const": false},
              "submission_ids": {"type": "array", "maxItems": 0},
              "reviewer_count": {"const": 0}
            }
          }
        }
      }
    },
    "claim_boundary": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
  }
}
