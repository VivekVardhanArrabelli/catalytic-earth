{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalytic.earth/schemas/family-onboarding-v1.schema.json",
  "title": "Catalytic Earth family onboarding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "family_id",
    "definition_version",
    "counted_object",
    "source_queries",
    "positive_evidence_required",
    "counterevidence_required",
    "oos_contract",
    "exclusion_rules",
    "output_namespace"
  ],
  "properties": {
    "schema_version": {"const": "catalytic-earth.family-onboarding.v1"},
    "family_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "definition_version": {"type": "string", "minLength": 1},
    "counted_object": {"const": "mechanism_family/fingerprint"},
    "source_queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "release", "query", "role"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "release": {"type": "string", "minLength": 1},
          "query": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "positive_evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "counterevidence_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "oos_contract": {"type": "string", "minLength": 1},
    "exclusion_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output_namespace": {"type": "string", "pattern": "^proposals/families/"}
  }
}
