{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalytic.earth/schemas/atlas50-readiness-report-v1.schema.json",
  "title": "Catalytic Earth Atlas-50 Phase B review/freeze readiness report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "status", "baseline_commit", "queues", "review_activity", "freeze_candidate", "source_reacquisition", "open_blocker_count", "blockers", "next_action_boundary", "compiled_follow_on_mechanisms", "gpu_hours", "claims_not_supported"],
  "properties": {
    "schema_version": {"const": "catalytic-earth.atlas50-readiness-report.v1"},
    "report_id": {"type": "string", "minLength": 1},
    "status": {"const": "ready_for_review_blocked_for_selection_freeze"},
    "baseline_commit": {"const": "375548419e7435efa2bffc89be5e32aa70864875"},
    "queues": {"type": "object"},
    "review_activity": {"type": "object"},
    "freeze_candidate": {"type": "object"},
    "source_reacquisition": {"type": "object"},
    "open_blocker_count": {"const": 5},
    "blockers": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object"}},
    "next_action_boundary": {"type": "string", "minLength": 1},
    "compiled_follow_on_mechanisms": {"const": 0},
    "gpu_hours": {"const": 0},
    "claims_not_supported": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 1}}
  }
}
