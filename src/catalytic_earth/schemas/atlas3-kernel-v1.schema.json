{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalytic.earth/schemas/atlas3-kernel-v1.schema.json",
  "title": "Catalytic Earth Atlas-3 first biological kernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "selection_sha256",
    "source_snapshot_set_sha256",
    "compilation_spec_sha256",
    "source_manifest_retrieved_at",
    "case_count",
    "record_count",
    "records",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "catalytic-earth.atlas3-kernel.v1"},
    "compiler_version": {"const": "catalytic-earth.atlas3-compiler.v1"},
    "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_snapshot_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compilation_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_retrieved_at": {
      "type": "string",
      "pattern": "Z$"
    },
    "case_count": {"const": 3},
    "record_count": {"const": 9},
    "records": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "mechanism-record-v2.schema.json"}
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "does_not_support": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
