{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalytic.earth/schemas/mechanism-record-v3.schema.json",
  "title": "Catalytic Earth mechanism record v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "case_id",
    "object_type",
    "evidence_tier",
    "label",
    "fixture_only",
    "status",
    "mechanism_granularity",
    "biological_scope",
    "reaction",
    "mechanism_proposals",
    "sites",
    "structures",
    "evidence",
    "counterevidence",
    "uncertainties",
    "detail_abstention",
    "claim_boundary",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "catalytic-earth.mechanism-record.v3"},
    "record_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "object_type": {
      "enum": ["reaction_or_source_gap", "source_annotation", "mechanism_hypothesis"]
    },
    "evidence_tier": {"type": "integer", "minimum": 0, "maximum": 2},
    "label": {"type": "string", "minLength": 1},
    "fixture_only": {"const": false},
    "status": {
      "enum": [
        "source_assertion",
        "documented_source_gap",
        "curated_source_annotation",
        "curated_non_detailed_annotation",
        "bounded_hypothesis",
        "bounded_non_detailed_hypothesis"
      ]
    },
    "mechanism_granularity": {
      "enum": ["not_applicable", "detailed", "detailed_with_alternatives", "non_detailed"]
    },
    "biological_scope": {"$ref": "#/$defs/biological_scope"},
    "reaction": {"$ref": "#/$defs/reaction"},
    "mechanism_proposals": {
      "type": "array",
      "items": {"$ref": "#/$defs/mechanism_proposal"}
    },
    "sites": {"type": "array", "items": {"$ref": "#/$defs/site"}},
    "structures": {"type": "array", "items": {"$ref": "#/$defs/structure"}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "counterevidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/counterevidence"}
    },
    "uncertainties": {
      "type": "array",
      "items": {"$ref": "#/$defs/uncertainty"}
    },
    "detail_abstention": {"$ref": "#/$defs/detail_abstention"},
    "claim_boundary": {"$ref": "#/$defs/claim_boundary"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "biological_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_label",
        "organism",
        "ec_number",
        "uniprot_ids",
        "direct_pdb_ids",
        "fold_classification_ids",
        "relationship_group_ids",
        "assay_candidate",
        "fingerprint_bridge"
      ],
      "properties": {
        "case_label": {"type": "string", "minLength": 1},
        "organism": {"type": "string", "minLength": 1},
        "ec_number": {"type": "string", "minLength": 1},
        "uniprot_ids": {"allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]},
        "direct_pdb_ids": {"allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]},
        "fold_classification_ids": {
          "allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]
        },
        "relationship_group_ids": {"$ref": "#/$defs/string_array"},
        "assay_candidate": {"type": "boolean"},
        "fingerprint_bridge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fingerprint_id", "use", "registry_write"],
          "properties": {
            "fingerprint_id": {"type": ["string", "null"]},
            "use": {"const": "historical_crosswalk_only_not_evidence"},
            "registry_write": {"const": false}
          }
        }
      }
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_status",
        "source_id",
        "source_record_id",
        "source_query",
        "directionality",
        "equation",
        "ec_number",
        "participants",
        "gap_context"
      ],
      "properties": {
        "source_status": {"enum": ["direct_record", "documented_query_gap"]},
        "source_id": {"const": "Rhea"},
        "source_record_id": {"type": ["string", "null"]},
        "source_query": {"type": "string", "minLength": 1},
        "directionality": {"enum": ["undirected", "unknown_no_direct_record"]},
        "equation": {"type": ["string", "null"]},
        "ec_number": {"type": "string", "minLength": 1},
        "participants": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/participant"}
        },
        "gap_context": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["query_result_count", "query_snapshot_kind", "interpretation"],
              "properties": {
                "query_result_count": {"const": 0},
                "query_snapshot_kind": {"const": "official_zero_row_tsv"},
                "interpretation": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "name",
        "participant_type",
        "side",
        "stoichiometry",
        "source_scope",
        "source_accession",
        "reactive_part_id",
        "source_row_count",
        "source_count_values"
      ],
      "properties": {
        "participant_id": {"type": "string", "pattern": "^(?:CHEBI|RHEA-COMP):[0-9]+$"},
        "name": {"type": "string", "minLength": 1},
        "participant_type": {
          "enum": ["small_molecule", "small_molecule_or_class", "macromolecule"]
        },
        "side": {"enum": ["left", "right"]},
        "stoichiometry": {"type": "integer", "minimum": 1},
        "source_scope": {"type": "string", "minLength": 1},
        "source_accession": {"type": "string", "minLength": 1},
        "reactive_part_id": {
          "type": ["string", "null"],
          "pattern": "^CHEBI:[0-9]+$"
        },
        "source_row_count": {"type": "integer", "minimum": 1},
        "source_count_values": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "mechanism_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "source_id",
        "source_record_id",
        "source_mechanism_id",
        "rating",
        "is_detailed",
        "preferred",
        "proposal_scope",
        "components_summary",
        "mechanism_text",
        "annotation_texts",
        "mechanism_steps",
        "terminal_state_source_step_ids",
        "structured_detail_status",
        "scheme_retrieval_issues"
      ],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "source_id": {"const": "M-CSA"},
        "source_record_id": {"type": "string", "pattern": "^M[0-9]{4}$"},
        "source_mechanism_id": {"type": "integer", "minimum": 1},
        "rating": {"type": "integer", "minimum": 0, "maximum": 3},
        "is_detailed": {"type": "boolean"},
        "preferred": {"type": "boolean"},
        "proposal_scope": {"enum": ["source_curated", "bounded_hypothesis_projection"]},
        "components_summary": {"type": "string", "minLength": 1},
        "mechanism_text": {"type": "string", "minLength": 1},
        "annotation_texts": {"$ref": "#/$defs/string_array"},
        "mechanism_steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/mechanism_step"}
        },
        "terminal_state_source_step_ids": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true
        },
        "structured_detail_status": {
          "enum": [
            "source_curved_arrows_preserved_no_atom_mapping_inference",
            "abstained_non_detailed_source"
          ]
        },
        "scheme_retrieval_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_step_id", "status", "source_url"],
            "properties": {
              "source_step_id": {"type": "integer", "minimum": 1},
              "status": {"const": "source_link_missing_http_404"},
              "source_url": {"type": "string", "format": "uri"}
            }
          }
        }
      }
    },
    "mechanism_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "order",
        "summary",
        "source_step_id",
        "is_inferred",
        "catalyst_site_ids",
        "evidence_ids",
        "source_scheme_sha256",
        "electron_flows",
        "electron_flow_semantics",
        "atom_mapping_status",
        "bond_edit_status"
      ],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "summary": {"type": "string", "minLength": 1},
        "source_step_id": {"type": "integer", "minimum": 1},
        "is_inferred": {"type": "boolean"},
        "catalyst_site_ids": {"$ref": "#/$defs/string_array"},
        "evidence_ids": {
          "allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]
        },
        "source_scheme_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "electron_flows": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/electron_flow"}
        },
        "electron_flow_semantics": {
          "const": "source_ordered_curved_arrow_endpoints_not_atom_mapped_bond_edits"
        },
        "atom_mapping_status": {"const": "not_inferred"},
        "bond_edit_status": {"const": "not_compiled_from_unmapped_source_scheme"}
      }
    },
    "electron_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_id", "source_point", "target_point", "ordering_semantics"],
      "properties": {
        "flow_id": {"type": "string", "minLength": 1},
        "source_point": {"$ref": "#/$defs/electron_point"},
        "target_point": {"$ref": "#/$defs/electron_point"},
        "ordering_semantics": {
          "const": "source_file_order_not_independently_inferred"
        }
      }
    },
    "electron_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_kind", "atoms"],
      "properties": {
        "point_kind": {"enum": ["electron_base_atom", "atom_set"]},
        "atoms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_atom_ref",
              "element",
              "formal_charge",
              "semantic_labels"
            ],
            "properties": {
              "source_atom_ref": {"type": "string", "minLength": 1},
              "element": {"type": "string", "minLength": 1},
              "formal_charge": {"type": ["integer", "null"]},
              "semantic_labels": {"$ref": "#/$defs/string_array"}
            }
          }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "uniprot_id",
        "residue_name",
        "sequence_position",
        "numbering_system",
        "roles",
        "pdb_mappings",
        "evidence_ids",
        "mapping_status",
        "notes"
      ],
      "properties": {
        "site_id": {"type": "string", "minLength": 1},
        "uniprot_id": {"type": "string", "minLength": 1},
        "residue_name": {"type": "string", "minLength": 1},
        "sequence_position": {"type": "integer", "minimum": 1},
        "numbering_system": {"const": "UniProt natural sequence"},
        "roles": {"$ref": "#/$defs/string_array"},
        "pdb_mappings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pdb_mapping"}
        },
        "evidence_ids": {
          "allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]
        },
        "mapping_status": {"const": "source_and_coordinate_verified"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "pdb_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdb_id",
        "chain_id",
        "author_position",
        "label_position",
        "applicability",
        "mapping_basis",
        "numbering_note"
      ],
      "properties": {
        "pdb_id": {"type": "string", "minLength": 4},
        "chain_id": {"type": "string", "minLength": 1},
        "author_position": {"type": "integer", "minimum": 1},
        "label_position": {"type": "integer", "minimum": 1},
        "applicability": {"enum": ["direct", "engineered_source_reference"]},
        "mapping_basis": {
          "enum": ["mcsa_reference_and_coordinate", "uniprot_chain_range_and_coordinate"]
        },
        "numbering_note": {"type": "string", "minLength": 1}
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdb_id",
        "applicability",
        "context_flags",
        "limitation",
        "experimental_method",
        "resolution_angstrom",
        "uniprot_chain_ranges",
        "evidence_ids"
      ],
      "properties": {
        "pdb_id": {"type": "string", "minLength": 4},
        "applicability": {"enum": ["direct", "engineered_source_reference"]},
        "context_flags": {
          "allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]
        },
        "limitation": {"type": "string", "minLength": 1},
        "experimental_method": {"type": ["string", "null"]},
        "resolution_angstrom": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "uniprot_chain_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chain_id", "uniprot_start", "uniprot_end"],
            "properties": {
              "chain_id": {"type": "string", "minLength": 1},
              "uniprot_start": {"type": "integer", "minimum": 1},
              "uniprot_end": {"type": "integer", "minimum": 1}
            }
          }
        },
        "evidence_ids": {
          "allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "source_record_id",
        "evidence_role",
        "applicability",
        "uri",
        "retrieval_status",
        "snapshot_sha256"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_record_id": {"type": "string", "minLength": 1},
        "evidence_role": {"type": "string", "minLength": 1},
        "applicability": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"},
        "retrieval_status": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "counterevidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counterevidence_id", "summary", "evidence_ids", "effect", "disposition"],
      "properties": {
        "counterevidence_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]
        },
        "effect": {"type": "string", "minLength": 1},
        "disposition": {"type": "string", "minLength": 1}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertainty_id", "summary", "status", "abstention"],
      "properties": {
        "uncertainty_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "status": {"const": "open"},
        "abstention": {"type": "string", "minLength": 1}
      }
    },
    "detail_abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason", "unsupported_fields", "source_basis_evidence_ids"],
      "properties": {
        "required": {"const": true},
        "reason": {"type": "string", "minLength": 1},
        "unsupported_fields": {
          "allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]
        },
        "source_basis_evidence_ids": {
          "allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": {"allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]},
        "does_not_support": {
          "allOf": [{"$ref": "#/$defs/string_array"}, {"minItems": 1}]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_sha256",
        "source_snapshot_set_sha256",
        "compilation_spec_sha256",
        "compiler_version"
      ],
      "properties": {
        "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_snapshot_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compilation_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiler_version": {"const": "catalytic-earth.atlas10-compiler.v1"}
      }
    }
  }
}
