_pdbx_entry_details.entry_id                   2AYH
_pdbx_entry_details.compound_details
;COMPND
  HYBRID PROTEIN MOLECULE; RESIDUES 1 - 16 ARE DERIVED
  FROM THE BACILLUS AMYLOLIQUEFACIENS BETA-GLUCANASE AND
