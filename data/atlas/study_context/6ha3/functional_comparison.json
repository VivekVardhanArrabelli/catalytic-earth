  "assays": [
    {
      "assay_id": "x5p_r5p_steady_state",
      "endpoint": "X5P/R5P turnover to S7P/G3P",
      "method": "NADH-coupled continuous spectrophotometry",
      "conditions": {
        "substrate_varied": "D-xylulose-5-phosphate",
        "acceptor": "2 mM D-ribose-5-phosphate",
        "temperature_celsius": 20,
        "pH": 7.6,
        "buffer": "50 mM glycyl-glycine",
        "wavelength_nm": 340,
        "ThDP_uM": 100,
        "CaCl2_mM": 5,
        "NADH_mM": 0.22,
        "enzyme_mg_per_mL_range": [
          0.1,
          2
        ]
      },
      "model": "Supplementary Methods equation 2 supplies the Michaelis-Menten analysis for ordinary steady-state rows. Table footnotes f/g override the T382E/T382Q parameter interpretation with cooperative K_0.5 and k_cat/K_0.5 values; an explicit cooperative steady-state fit equation is not supplied by the retained printed pages 5-7.",
      "source_locators": [
        "Supplementary Methods printed page 5, equations 1-2",
        "Extended Data Table 2a footnotes a, f, g"
      ]
    },
    {
      "assay_id": "f6p_stopped_flow",
      "endpoint": "F6P Michaelis-complex formation and reversible covalent F6P-ThDP adduct formation",
      "method": "325 nm stopped-flow cofactor reporter",
      "conditions": {
        "substrate_varied": "D-fructose-6-phosphate",
        "temperature_celsius": 4,
        "pH": 7.6,
        "buffer": "50 mM glycyl-glycine",
        "CaCl2_mM": 5,
        "enzyme_stock_mg_per_mL": 4,
        "mixing": "1+1; enzyme value is stated before mixing",
        "wavelength_nm": 325,
        "path_length_mm": 10
      },
      "model": "Source equations 6-8: k_app(S) = k_reverse + k_forward*S^n/(K_0.5^n + S^n). k_max_ES refers to preceding noncovalent ES formation, not k_forward.",
      "K_0.5_scope": "The source interprets this fitted parameter as the pre-equilibrium substrate-binding constant in its two-step model. It is not assigned to the X5P assay or generalized as an independent thermodynamic K_D.",
      "source_locators": [
        "Supplementary Methods printed pages 6-7, equations 6-8",
        "Extended Data Table 2a footnotes c-e"
      ],
      "transient_fit_scope": "The source describes wild-type monophasic transients fitted by equation 6, and variant biphasic transients by equation 7. The corresponding k_app (wild type) or k_app2 (variant covalent phase) enters equation 8. Instrument-limited initial phases and unavailable rows remain as reported; no raw trace is re-fitted or assumed available for every variant."
    }
  ],
