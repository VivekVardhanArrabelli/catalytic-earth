  "adjudication": {
    "arrow_role_pattern": "The two directed arrows align under the three declared local roles: lysine-adduct bond to lysine N, and substrate-N lone pair to the existing substrate-N/adduct-C bond. This is an endpoint-only pattern, not an inferred bond edit or an accepted stereochemical or actor-state correspondence.",
    "consumer_boundary": "Every substrate-N endpoint touches a source stereobond. The current consumer refuses this context even if all non-flow atoms are explicitly excluded.",
    "distinct_actor_context": "The cofactor pyridine and phenolic oxygen charges, phosphate proton depiction, lysine explicit-H inventory and substrate sidechains differ. A full selected actor-state equality is not established.",
    "outcome": "Retain the rejected correspondence question and its exact source witnesses. Do not relax the stereo guard or normalize charge/H to force a match.",
    "scientific_non_equivalence_proven": false,
    "canonical_stereochemistry_assigned": false,
    "physical_atom_map": false,
    "after_state_replay": false,
    "whole_mechanism_equivalence": false,
